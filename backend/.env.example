# Required
VIRUSTOTAL_API_KEY=

# Optional: leave empty to skip the Google Safe Browsing check
GOOGLE_SAFE_BROWSING_KEY=

# Optional: only needed for the SMS feature
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# The exact public URL Twilio posts to, e.g. https://abc123.ngrok-free.app/sms
TWILIO_WEBHOOK_URL=

# Optional tuning (defaults shown)
ALLOWED_ORIGINS=http://localhost:3000
VT_REQUESTS_PER_MINUTE=4
SCANS_PER_HOUR_PER_CLIENT=60
CACHE_TTL_SECONDS=3600
